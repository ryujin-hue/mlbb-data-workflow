{
  "name": "mlbb-data-workflow",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-22",
  "previews": {},
  "triggers": {
    "crons": [
      "0 2 * * *"
    ]
  },
  "vars": {
    "UPSTREAM_BASE_URL": "https://raw.githubusercontent.com/achedon12/mlbb/develop",
    "CRON_HOUR_UTC": "2",
    "DATA_CACHE_SECONDS": "300"
  }
}
