{
  "name": "mlbb-data-workflow",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-22",
  "previews": {},
  "triggers": {
    "crons": [
      "0 2 * * *"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "MLBB_KV",
      "id": "b3d0ca5b38974afc92192873b81f23c3",
      "preview_id": "fbbe6f4c452f48cc9426cc3b6ebb5804"
    }
  ],
  "assets": {
    "directory": "./site",
    // Binding untuk akses aset dari dalam Worker (route /audio/*).
    "binding": "ASSETS",
    // Route /audio/* dihantar ke Worker dulu supaya boleh pulangkan 206 +
    // Content-Range (Workers Static Assets sahaja hantar 200 penuh, dan
    // Safari/iOS perlukan Range untuk main media).
    "run_worker_first": ["/audio/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "UPSTREAM_BASE_URL": "https://raw.githubusercontent.com/achedon12/mlbb/develop",
    "CRON_HOUR_UTC": "2",
    "DATA_CACHE_SECONDS": "300"
  }
}
