/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://raw.githubusercontent.com data: blob:; media-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; worker-src 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/dataset/*
  Cache-Control: public, max-age=300

# Lagu hero - immutable, content-type determined oleh ekstensi fail (.mp3 -> audio/mpeg).
/audio/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache
